# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── CORS ────────────────────────────────────────────────────────────────────
# Erlaubte Website-Origins (kommagetrennt). In der Entwicklung ist zusätzlich jeder localhost-Port erlaubt.
CORS_ORIGIN=http://localhost:3000
# Hinter einem Reverse-Proxy (nginx, Load-Balancer) auf true setzen
TRUST_PROXY=false

# ── Speicher ────────────────────────────────────────────────────────────────
# Anfragen werden als JSONL in <DATA_DIR>/inquiries.jsonl abgelegt (Standard: ./data)
DATA_DIR=

# ── Rate-Limits ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
INQUIRY_RATE_LIMIT_MAX=5
INQUIRY_RATE_LIMIT_WINDOW=10 minutes

# ── E-Mail-Benachrichtigung (optional) ──────────────────────────────────────
# Ohne SMTP_HOST werden Anfragen gespeichert, aber nur im Log gemeldet.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Clean Car Solution Website <info@cleancarsolution.de>
MAIL_TO=info@cleancarsolution.de

# ── Datenschutz ─────────────────────────────────────────────────────────────
# Salz für den IP-Hash (es wird nie die rohe IP gespeichert) – in Produktion zufälligen Wert setzen
IP_HASH_SALT=
