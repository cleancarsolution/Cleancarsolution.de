# Kanonische URL der Website (SEO, Open Graph, Sitemap) – auf Vercel (Production): https://cleancarsolution.de
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Kontaktformular → E-Mail per Resend (nur serverseitig, gelangt nie in den Browser) ──────────
# API-Key: resend.com → API Keys → „Create API Key“ (Permission: Sending access).
# Ohne Key wird eine Anfrage lokal nur protokolliert; in Produktion schlägt der Versand fehl.
RESEND_API_KEY=
# Absender – die Domain muss bei Resend verifiziert sein (DNS-Einträge bei Strato)
MAIL_FROM=Clean Car Solution Website <info@cleancarsolution.de>
# Empfänger (mehrere kommagetrennt)
MAIL_TO=info@cleancarsolution.de
